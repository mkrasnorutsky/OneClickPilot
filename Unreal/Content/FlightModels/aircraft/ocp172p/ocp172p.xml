  </ground_reactions>
  <propulsion>
    <engine file="practice_piston">
      <feed>0</feed>
      <feed>1</feed>
      <thruster file="practice_prop">
        <location name="THRUSTER" unit="IN">
          <x>-66</x>
          <y>0</y>
          <z>0</z>
        </location>
        <orient unit="DEG">
          <roll>0</roll>
          <pitch>0</pitch>
          <yaw>0</yaw>
        </orient>
        <sense>1</sense>
        <p_factor>2</p_factor>
      </thruster>
    </engine>
    <tank type="FUEL" number="0">
      <location name="TANK" unit="IN">
        <x>0</x>
        <y>-80</y>
        <z>14</z>
      </location>
      <capacity>126</capacity>
      <contents>126</contents>
      <priority>1</priority>
    </tank>
    <tank type="FUEL" number="1">
      <location name="TANK" unit="IN">
        <x>0</x>
        <y>80</y>
        <z>14</z>
      </location>
      <capacity>126</capacity>
      <contents>126</contents>
      <priority>1</priority>
    </tank>
  </propulsion>
  <flight_control name="Practice controls">
    <channel name="Flaps">
      <kinematic name="Flap actuator">
        <input>fcs/flap-cmd-norm</input>
        <traverse>
          <setting>
            <position>0</position>
            <time>0</time>
          </setting>
          <setting>
            <position>10</position>
            <time>1.8</time>
          </setting>
          <setting>
            <position>20</position>
            <time>1.2</time>
          </setting>
          <setting>
            <position>30</position>
            <time>1.2</time>
          </setting>
        </traverse>
        <output>fcs/flap-pos-deg</output>
      </kinematic>
      <pure_gain name="Flap fraction">
        <input>fcs/flap-pos-deg</input>
        <gain>0.03333333333333333</gain>
        <output>fcs/flap-pos-norm</output>
      </pure_gain>
    </channel>
  </flight_control>
  <aerodynamics>
    <axis name="LIFT">
      <function name="aero/practice/wing-lift">
        <product>
          <property>aero/qbar-area</property>
          <table>
            <independentVar>aero/alpha-rad</independentVar>
            <tableData>
-0.6 -0.55
-0.28 -0.85
-0.06 0
0 0.3
0.2 1.28
0.28 1.4
0.43 0.82
0.8 0.35
</tableData>
          </table>
        </product>
      </function>
      <function name="aero/practice/flap-lift">
        <product>
          <property>aero/qbar-area</property>
          <value>0.38</value>
          <property>fcs/flap-pos-norm</property>
        </product>
      </function>
    </axis>
    <axis name="DRAG">
      <function name="aero/practice/parasite-drag">
        <product>
          <property>aero/qbar-area</property>
          <value>0.034</value>
        </product>
      </function>
      <function name="aero/practice/induced-drag">
        <product>
          <property>aero/qbar-area</property>
          <table>
            <independentVar>aero/alpha-rad</independentVar>
            <tableData>
-0.6 0.28
-0.3 0.06
-0.06 0
0 0.005
0.15 0.06
0.28 0.11
0.5 0.34
0.8 0.75
</tableData>
          </table>
        </product>
      </function>
      <function name="aero/practice/flap-drag">
        <product>
          <property>aero/qbar-area</property>
          <value>0.085</value>
          <property>fcs/flap-pos-norm</property>
