      <static_friction>0.79</static_friction>
      <dynamic_friction>0.52</dynamic_friction>
      <rolling_friction>0.021</rolling_friction>
      <spring_coeff>3900</spring_coeff>
      <damping_coeff>620</damping_coeff>
